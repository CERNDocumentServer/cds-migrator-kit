# Dockerfile that builds a fully functional image of your app.
#
# This image installs all Python dependencies for your application. It's based
# on the Invenio Debian image (https://github.com/inveniosoftware/docker-invenio),
# which provides Python 3.14 as required by cds-videos.
#
# Note: It is important to keep the commands in this file in sync with your
# bootstrap script located in ./scripts/bootstrap.

ARG BUILD_PLATFORM=linux/amd64
FROM --platform=${BUILD_PLATFORM} ghcr.io/inveniosoftware/invenio:debian-python3.14

# python-ldap has no wheel and is built against OpenLDAP. XRootD comes with
# its wheel, which bundles the client libraries and the Kerberos plugin.
# Kerberos is needed to build requests-kerberos and to generate the keytab.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        krb5-user \
        libkrb5-dev \
        libldap2-dev \
        libsasl2-dev && \
    rm -rf /var/lib/apt/lists/*

# FFmpeg 5.0 (static build)
RUN mkdir /usr/local/bin/ffmpeg && \
    curl -fsSL https://cds-resources.web.cern.ch/cds-resources/cds-videos/ffmpeg/5.0/ffmpeg-release-amd64-static.tar.xz | \
        tar -xJ --strip-components=1 --directory=/usr/local/bin/ffmpeg/ && \
    ln -s /usr/local/bin/ffmpeg/ffmpeg /usr/bin/ffmpeg && \
    ln -s /usr/local/bin/ffmpeg/ffprobe /usr/bin/ffprobe

# Volume where to mount the keytab as a secrets
# If credentials are passed as username and password with
# KEYTAB_USER and KEYTAB_PWD environment variables, a keytab will be
# generated and stored in KEYTAB_PATH.
COPY ./krb5.conf /etc/krb5.conf

ENV WORKING_DIR=/opt/cds-migrator-kit
ENV INVENIO_INSTANCE_PATH=${WORKING_DIR}/var/instance
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# copy everything inside /src
RUN mkdir -p ${WORKING_DIR}/src
COPY ./ ${WORKING_DIR}/src
WORKDIR ${WORKING_DIR}/src

RUN python -m venv .venv
ENV PATH=${WORKING_DIR}/src/.venv/bin:${PATH}

# install all dependencies
RUN echo "Install app dependencies"
RUN pip install "requests-kerberos==0.14.0"
# fs (needed by xrootdpyfs) still imports pkg_resources, removed in setuptools 82
RUN pip install "setuptools<82"
RUN pip install ."[all,videos]"
# XRootD
RUN pip install "invenio-xrootd>=3.1.0,<4.0.0"
# /XRootD

# OpenShift runs with an arbitrary UID in GID 0
RUN chown -R invenio:0 ${WORKING_DIR} && \
    chmod -R g=u ${WORKING_DIR}

USER ${INVENIO_USER_ID}

ENTRYPOINT [ "bash", "-c"]
